# Окружение и кэши — они пересобираются, и у каждого свои.
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
build/
dist/

# Мусор файлового окна macOS.
.DS_Store

# Пакет передачи дизайна. Он не тайна — он двадцать пять мегабайт
# исходников макетов, и человеку, скачавшему сервис ради нарезки
# видео, они не нужны. Проверка, которая сверяет с ним копии
# `tokens.css` и `components.css`, честно пропускается, когда пакета
# рядом нет.
Дизайн системы Vertcut/

# Видео и звук. Здесь их быть не должно ни одного: разборы живут
# в ~/vertcut, а не в папке кода. Строка стоит заслоном от случайного
# броска файла в папку проекта — такой файл весит гигабайты и уедет
# в раздачу молча.
*.mp4
*.mov
*.mkv
*.m4v
*.wav

# Настройки и ключ живут в ~/.vertcut и сюда попасть не могут вовсе.
# Строка стоит на случай песочницы, заведённой прямо здесь: её
# настройки ложатся в `.settings/` (на любой глубине — закрыта).
# `config.json` — только в корне: глубже его закрывает `.settings/`,
# а файлу с таким именем в коде закрытая строка не дала бы попасть
# в коммит молча.
.settings/
/config.json
spending.json
.env

# Личная папка автора: замысел, дневник сессий, аудит, разовые
# скрипты переезда. Лежит рядом с кодом, в репозиторий не входит.
private/

# Локальные настройки ИИ-помощника — у каждого свои.
.claude/

# Журналы и собранные архивы рядом с кодом: их место не в репозитории.
*.log
*.zip
